# Optional Tradovate real-time market data (required for LIVE freshness).
# Without these, the app uses Yahoo CME delayed (~10 minutes) and labels it DELAYED.
#
# Also requires API Access add-on + CME market-data entitlement on the Tradovate account.
# Demo MD: wss://md-demo.tradovateapi.com — Live MD: wss://md.tradovateapi.com

TRADOVATE_NAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SEC=
# demo | live
TRADOVATE_ENV=demo
# Contract shown on Tradovate (e.g. NQZ6 / NQZ26)
TRADOVATE_SYMBOL=NQZ6
