# REQUIRED for LIVE Tradovate platform prices (tick stream).
# Without these, the app uses delayed Yahoo only and labels it DELAYED.
# This is NOT TradingView — prices come from Tradovate MD when configured.
#
# How to get CID / SEC / API password:
#   Tradovate Trader → Application Settings → API Access (add-on)
#   → Create API Key → copy CID + SEC
#   → set a dedicated API password (use THAT as TRADOVATE_PASSWORD, not only
#     your normal Trader login password)
#
# Demo MD: wss://md-demo.tradovateapi.com/v1/websocket
# Live MD:  wss://md.tradovateapi.com/v1/websocket

TRADOVATE_NAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=NQZ6Live
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SEC=
# demo | live
TRADOVATE_ENV=demo
# Contract as shown on Tradovate (e.g. NQZ6 / NQZ26)
TRADOVATE_SYMBOL=NQZ6
